# API origin used by the TanStack Start server.
API_ORIGIN=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
# Enabled by pnpm dev:api. Disabled by default in pnpm start:api.
DEMO_MODE=false
# Both API and frontend must use imap to enable a configured real account.
MAILBOX_MODE=demo
# Both API and frontend must use the same authentication mode.
POSTFOLD_AUTH=basic
# Keycloak SSO; see docs/keycloak.md. Client secret and tokens stay server-side.
# POSTFOLD_AUTH=keycloak
# POSTFOLD_ORIGIN=https://support.example.com
# KEYCLOAK_ISSUER=https://sso.example.com/realms/company
# KEYCLOAK_CLIENT_ID=postfold
# KEYCLOAK_CLIENT_SECRET_FILE=/etc/postfold/secrets/keycloak-client.secret
# KEYCLOAK_REQUIRED_ROLE=support
# KEYCLOAK_ALLOW_LOCAL_HTTP=true
# Live mode requires DATABASE_URL and protected files; see docs/mailbox-setup.md.
# MAILBOX_ID=support
# MAILBOX_KEY_FILE=/etc/postfold/secrets/mailbox.key
# MAILBOX_KEY_ID=v1
# POSTFOLD_ACCESS_FILE=/etc/postfold/secrets/access.json
# MAILBOX_SYNC_LIMIT=200
# MAILBOX_CA_FILE=/path/to/private-ca.pem
# Demo PostgreSQL connection. Credentials are for local development only.
DATABASE_URL=postgresql://mailer_demo:mailer_demo@127.0.0.1:55432/mailer_support
