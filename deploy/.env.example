# Use a release tag or immutable digest for production; edge follows tested main.
POSTFOLD_IMAGE=ghcr.io/frulko/postfold:edge
POSTFOLD_ORIGIN=https://support.example.com
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_HEXADECIMAL_PASSWORD
POSTFOLD_AUTH=keycloak
KEYCLOAK_ISSUER=https://sso.example.com/realms/company
KEYCLOAK_CLIENT_ID=postfold
KEYCLOAK_REQUIRED_ROLE=support
MAILBOX_MODE=imap
DEMO_MODE=false
MAILBOX_ID=support
MAILBOX_KEY_ID=v1
